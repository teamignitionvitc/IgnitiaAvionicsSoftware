# Simple Makefile for deployment decision test
# This compiles the test as a native executable for quick testing

CC = gcc
CFLAGS = -Wall -Wextra -g -I../src -I../src/modules -I../src/utils
LDFLAGS = -lm

# Source files
SOURCES = test_deployment_decision.c \
          ../src/modules/flight_logic.c \
          ../src/modules/state_machine.c

# Object files
OBJECTS = $(SOURCES:.c=.o)

# Target executable
TARGET = test_deployment_decision

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) $(LDFLAGS) -o $(TARGET)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET)

run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run
